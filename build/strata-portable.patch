diff --git a/Dockerfile b/Dockerfile
index 6430601..72a2146 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -73,6 +73,15 @@ RUN .venv/bin/python - <<'PYEOF'
 import json, os, pathlib, shutil
 import setup
 
+# strata-docker: build for any AVX2 CPU (STRATA_PORTABLE=ON, the release engine's baseline) instead of
+# native code for the CPU that runs docker build, so a published image runs on other machines. Every
+# cmake_build gets it, replacing any STRATA_PORTABLE the call passes itself.
+_cmake_build = setup.cmake_build
+def _portable_cmake_build(src, bdir, target, defs, *rest, **kw):
+    defs = [d for d in defs if not d.startswith("-DSTRATA_PORTABLE=")] + ["-DSTRATA_PORTABLE=ON"]
+    return _cmake_build(src, bdir, target, defs, *rest, **kw)
+setup.cmake_build = _portable_cmake_build
+
 llama = setup.get_llama_cpp()
 nvcc, _ = setup.find_nvcc()
 arch = os.environ.get("CUDA_ARCHITECTURES", "75;80;86;89;120").strip().strip('"').replace(",", ";")
